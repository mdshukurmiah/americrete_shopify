{% liquid
  assign block_settings = block.settings
  assign quote_text = block_settings.quote
  assign author_name = block_settings.author_name
  assign author_info = block_settings.author_info
  assign author_initials = block_settings.author_initials
  assign rating = block_settings.rating | default: 'none'

  if author_initials == blank and author_name != blank
    assign parts = author_name | split: ' '
    if parts.size > 1
      assign first_char = parts[0] | slice: 0, 1
      assign second_char = parts[1] | slice: 0, 1
      assign author_initials = first_char | append: second_char | upcase
    else
      assign author_initials = author_name | slice: 0, 2 | upcase
    endif
  endif
%}

{% style %}
  .testimonial-block--{{ block.id }} {
    {% if block_settings.card_background != blank %}--card-bg: {{ block_settings.card_background }};{% endif %}
    {% if block_settings.card_border_color != blank %}--card-border-color: {{ block_settings.card_border_color }};{% endif %}
    {% if block_settings.quote_color != blank %}--quote-color: {{ block_settings.quote_color }};{% endif %}
    {% if block_settings.author_name_color != blank %}--author-name-color: {{ block_settings.author_name_color }};{% endif %}
    {% if block_settings.author_info_color != blank %}--author-info-color: {{ block_settings.author_info_color }};{% endif %}
    {% if block_settings.avatar_bg != blank %}--avatar-bg: {{ block_settings.avatar_bg }};{% endif %}
    {% if block_settings.avatar_text_color != blank %}--avatar-text-color: {{ block_settings.avatar_text_color }};{% endif %}
    {% if block_settings.star_color != blank %}--star-color: {{ block_settings.star_color }};{% endif %}
  }
{% endstyle %}

<div
  class="testimonial-block testimonial-block--{{ block.id }} border-style spacing-style size-style"
  style="{% render 'spacing-style', settings: block_settings %}{% render 'size-style', settings: block_settings %}"
  {{ block.shopify_attributes }}
>
  <div class="testimonial-card__content">
    {% if rating != 'none' %}
      <div class="testimonial-card__rating">
        {% if rating == 'quote' %}
          <span class="testimonial-card__quote-icon">
            <svg aria-hidden="true" focusable="false" role="presentation" viewBox="0 0 41 35" width="20" height="17">
              <path d="M10.208 17.711h6.124v16.332H0V21.684C0 8.184 5.444.956 16.332 0v6.125c-4.083 1.14-6.124 4.414-6.124 9.82v1.766Zm24.498 0h6.124v16.332H24.498V21.684C24.498 8.184 29.942.956 40.83 0v6.125c-4.083 1.14-6.124 4.414-6.124 9.82v1.766Z" fill="currentColor"/>
            </svg>
          </span>
        {% else %}
          <span class="testimonial-card__stars">
            {% case rating %}
              {% when '5-stars' -%}
                ★★★★★
              {% when '4-stars' -%}
                ★★★★
              {% when '3-stars' -%}
                ★★★
              {% when '2-stars' -%}
                ★★
              {% when '1-star' -%}
                ★
            {% endcase %}
          </span>
        {% endif %}
      </div>
    {% endif %}

    {% if quote_text != blank %}
      <div class="testimonial-card__quote rte">&ldquo;{{ quote_text | strip_html }}&rdquo;</div>
    {% endif %}

    <div class="testimonial-card__footer">
      <div class="testimonial-card__author-wrapper">
        {% if block_settings.image != blank %}
          <div class="testimonial-card__avatar testimonial-card__avatar--img">
            {{
              block_settings.image
              | image_url: width: 120
              | image_tag: loading: 'lazy', class: 'testimonial-card__avatar-img', alt: author_name
            }}
          </div>
        {% elsif author_initials != blank %}
          <div class="testimonial-card__avatar testimonial-card__avatar--initials">
            <span>{{ author_initials }}</span>
          </div>
        {% endif %}

        <div class="testimonial-card__author-details">
          {% if author_name != blank %}
            <div class="testimonial-card__author-name">{{ author_name }}</div>
          {% endif %}
          {% if author_info != blank %}
            <div class="testimonial-card__author-info">{{ author_info }}</div>
          {% endif %}
          {% if block_settings.verified %}
            <div class="testimonial-card__verified">
              <svg
                viewBox="0 0 24 24"
                fill="none"
                aria-hidden="true"
                width="14"
                height="14"
                style="display: inline-block; vertical-align: middle; margin-right: 4px;"
              >
                <path d="M12 3.5c2.25 1.6 4.93 2.4 7.7 2.4v5.24c0 4.87-2.86 8.14-7.7 9.86-4.84-1.72-7.7-4.99-7.7-9.86V5.9C7.07 5.9 9.75 5.1 12 3.5Z" stroke="currentColor" stroke-linejoin="round"/>
                <path d="m8.8 12.2 2.07 2.07 4.33-4.34" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
              <span>Verified Buyer</span>
            </div>
          {% endif %}
        </div>
      </div>
    </div>
  </div>
</div>

{% stylesheet %}
  .testimonial-block {
    display: flex;
    flex-direction: column;
    background-color: var(--card-bg, #ffffff);
    border: 1px solid var(--card-border-color, #e5e5e0);
    border-radius: 4px;
    overflow: hidden;
    height: 100%;
    width: 100%;
    box-sizing: border-box;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .testimonial-block:hover {
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.06);
    transform: translateY(-2px);
  }

  .testimonial-block .testimonial-card__content {
    display: flex;
    flex-direction: column;
    flex-grow: 1;
    justify-content: space-between;
    box-sizing: border-box;
  }

  .testimonial-block .testimonial-card__rating {
    margin-bottom: 12px;
  }

  .testimonial-block .testimonial-card__stars {
    color: var(--star-color, #f59e0b);
    font-size: 16px;
    letter-spacing: 2px;
  }

  .testimonial-block .testimonial-card__quote-icon {
    color: var(--quote-color, #6b7280);
    opacity: 0.5;
  }

  .testimonial-block .testimonial-card__quote {
    font-size: 15px;
    font-style: italic;
    line-height: 1.6;
    color: var(--quote-color, #374151);
    margin-bottom: 18px;
    padding-bottom: 18px;
    border-bottom: 1px solid var(--card-border-color);
    flex-grow: 1;
  }

  .testimonial-block .testimonial-card__footer {
    display: flex;
    align-items: center;
  }

  .testimonial-block .testimonial-card__author-wrapper {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .testimonial-block .testimonial-card__avatar {
    width: 40px;
    height: 40px;
    min-width: 40px;
    border-radius: 50%;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: var(--avatar-bg, #e5e4df);
    color: var(--avatar-text-color, #4b5563);
  }

  .testimonial-block .testimonial-card__avatar--initials {
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.05em;
  }

  .testimonial-block .testimonial-card__avatar-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .testimonial-block .testimonial-card__author-details {
    display: flex;
    flex-direction: column;
  }

  .testimonial-block .testimonial-card__author-name {
    font-size: 13px;
    font-weight: 700;
    color: var(--author-name-color, #111827);
    line-height: 1.3;
    margin-bottom: 2px;
  }

  .testimonial-block .testimonial-card__author-info {
    font-size: 11px;
    font-weight: 500;
    color: var(--author-info-color, #6b7280);
    line-height: 1.4;
  }

  .testimonial-block .testimonial-card__verified {
    display: flex;
    align-items: center;
    font-size: 11px;
    font-weight: 600;
    color: var(--author-info-color, #059669);
    margin-top: 2px;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Testimonial",
  "tag": null,
  "settings": [
    {
      "type": "textarea",
      "id": "quote",
      "label": "Quote / Testimonial text",
      "default": "Placeholder testimonial. Product performance quote from a Pro tier contractor about a specific job win or long-term relationship with Americrete."
    },
    {
      "type": "text",
      "id": "author_name",
      "label": "Author name",
      "default": "Franklin C."
    },
    {
      "type": "text",
      "id": "author_initials",
      "label": "Author initials (e.g. FC)",
      "placeholder": "FC",
      "info": "Leave blank to generate automatically from name"
    },
    {
      "type": "text",
      "id": "author_info",
      "label": "Author details / info",
      "default": "Owner · West Coast Deck Waterproofing · Long Beach, CA"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Author avatar photo (optional)"
    },
    {
      "type": "select",
      "id": "rating",
      "label": "Rating / Icon",
      "default": "none",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "quote", "label": "Quote Icon" },
        { "value": "5-stars", "label": "5 Stars" },
        { "value": "4-stars", "label": "4 Stars" },
        { "value": "3-stars", "label": "3 Stars" },
        { "value": "2-stars", "label": "2 Stars" },
        { "value": "1-star", "label": "1 Star" }
      ]
    },
    {
      "type": "checkbox",
      "id": "verified",
      "label": "Show verified buyer badge",
      "default": false
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "card_background",
      "label": "Card background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "card_border_color",
      "label": "Card border color",
      "default": "#e5e5e0"
    },
    {
      "type": "color",
      "id": "quote_color",
      "label": "Quote text color",
      "default": "#374151"
    },
    {
      "type": "color",
      "id": "author_name_color",
      "label": "Author name color",
      "default": "#111827"
    },
    {
      "type": "color",
      "id": "author_info_color",
      "label": "Author info color",
      "default": "#6b7280"
    },
    {
      "type": "color",
      "id": "avatar_bg",
      "label": "Avatar circle background",
      "default": "#e5e4df"
    },
    {
      "type": "color",
      "id": "avatar_text_color",
      "label": "Avatar initials color",
      "default": "#4b5563"
    },
    {
      "type": "color",
      "id": "star_color",
      "label": "Star rating color",
      "default": "#f59e0b"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "t:settings.left",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "t:settings.right",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Testimonial"
    }
  ]
}
{% endschema %}
