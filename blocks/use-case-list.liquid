{% liquid
  assign block_settings = block.settings
  assign items = product.metafields.custom.use_cases.value
%}

{% render 'contrast-override',
  background_color: block_settings.background_color,
  text_color: block_settings.text_color,
  section_id: block.id
%}

{% style %}
  #block-{{ block.id }}.use-case-list-block {
    --use-case-bg: {% if block_settings.card_bg_color != blank %}{{ block_settings.card_bg_color }}{% else %}#f7f7f5{% endif %};
    --use-case-border-color: {% if block_settings.card_border_color != blank %}{{ block_settings.card_border_color }}{% else %}#e5e7eb{% endif %};
    --use-case-border-width: {{ block_settings.card_border_width | default: 1 }}px;
    --use-case-border-radius: {{ block_settings.card_border_radius | default: 6 }}px;
    --use-case-padding-y: {{ block_settings.card_padding_y | default: 24 }}px;
    --use-case-padding-x: {{ block_settings.card_padding_x | default: 24 }}px;
    --use-case-text-align: {{ block_settings.alignment | default: 'left' }};

    --use-case-badge-bg: {% if block_settings.badge_bg_color != blank %}{{ block_settings.badge_bg_color }}{% else %}#1e293b{% endif %};
    --use-case-badge-color: {% if block_settings.badge_color != blank %}{{ block_settings.badge_color }}{% else %}#ffffff{% endif %};
    --use-case-badge-size: {{ block_settings.badge_font_size | default: 11 }}px;

    --use-case-title-size: {{ block_settings.title_font_size | default: 18 }}px;
    --use-case-title-color: {% if block_settings.title_color != blank %}{{ block_settings.title_color }}{% else %}#1e293b{% endif %};

    --use-case-desc-size: {{ block_settings.desc_font_size | default: 14 }}px;
    --use-case-desc-color: {% if block_settings.desc_color != blank %}{{ block_settings.desc_color }}{% else %}#475569{% endif %};

    --use-case-divider-color: {% if block_settings.divider_color != blank %}{{ block_settings.divider_color }}{% else %}#e2e8f0{% endif %};
    --use-case-divider-margin: {{ block_settings.divider_spacing | default: 16 }}px;

    --use-case-note-size: {{ block_settings.note_font_size | default: 13 }}px;
    --use-case-note-color: {% if block_settings.note_color != blank %}{{ block_settings.note_color }}{% else %}#64748b{% endif %};

    --grid-columns-desktop: {{ block_settings.columns_desktop | default: 3 }};
    --grid-columns-mobile: {{ block_settings.columns_mobile | default: 1 }};
    --grid-gap-desktop: {{ block_settings.columns_gap | default: 24 }}px;
    --grid-gap-mobile: {{ block_settings.columns_gap_mobile | default: 16 }}px;
    --grid-row-gap: {{ block_settings.rows_gap | default: 24 }}px;
  }

  {% if block_settings.custom_css != blank %}
    {% if block_settings.custom_css contains 'selector' %}
      {% assign target_selector = '#block-' | append: block.id %}
      {{ block_settings.custom_css | replace: 'selector', target_selector }}
    {% else %}
      #block-{{ block.id }} {
        {{ block_settings.custom_css }}
      }
    {% endif %}
  {% endif %}
{% endstyle %}

{% stylesheet %}
  .use-case-list-block {
    display: block;
    width: 100%;
    box-sizing: border-box;
  }

  .use-case-list__grid {
    display: grid;
    grid-template-columns: repeat(var(--grid-columns-desktop, 3), minmax(0, 1fr));
    column-gap: var(--grid-gap-desktop, 24px);
    row-gap: var(--grid-row-gap, 24px);
    width: 100%;
    box-sizing: border-box;
  }

  @media screen and (max-width: 767px) {
    .use-case-list__grid {
      grid-template-columns: repeat(var(--grid-columns-mobile, 1), minmax(0, 1fr));
      column-gap: var(--grid-gap-mobile, 16px);
    }
  }

  .use-case-card {
    display: flex;
    flex-direction: column;
    position: relative;
    width: 100%;
    box-sizing: border-box;
    background-color: var(--use-case-bg);
    border: var(--use-case-border-width) solid var(--use-case-border-color);
    border-radius: var(--use-case-border-radius);
    padding: var(--use-case-padding-y) var(--use-case-padding-x);
    transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
    height: 100%;
    text-align: var(--use-case-text-align);
  }

  .use-case-card__badge-wrap {
    margin-bottom: 12px;
    display: flex;
    justify-content: flex-start;
  }

  .use-case-card[style*='--use-case-text-align: center'] .use-case-card__badge-wrap {
    justify-content: center;
  }

  .use-case-card[style*='--use-case-text-align: right'] .use-case-card__badge-wrap {
    justify-content: flex-end;
  }

  .use-case-card__badge {
    display: inline-block;
    background-color: var(--use-case-badge-bg);
    color: var(--use-case-badge-color);
    font-size: var(--use-case-badge-size);
    font-weight: 700;
    letter-spacing: 1px;
    text-transform: uppercase;
    padding: 4px 10px;
    border-radius: 4px;
    line-height: 1.25;
  }

  .use-case-card__title {
    margin: 0 0 8px 0;
    font-size: var(--use-case-title-size);
    font-weight: 700;
    color: var(--use-case-title-color);
    line-height: 1.35;
    word-break: break-word;
  }

  .use-case-card__description {
    font-size: var(--use-case-desc-size);
    color: var(--use-case-desc-color);
    line-height: 1.55;
    margin: 0 0 12px;
  }

  .use-case-card__description p {
    margin: 0 0 8px 0;
    font-size: inherit;
    color: inherit;
  }

  .use-case-card__description p:last-child {
    margin-bottom: 0;
  }

  .use-case-card__divider {
    width: 100%;
    height: 1px;
    background-color: var(--use-case-divider-color);
    margin: 0;
  }

  .use-case-card__note {
    font-size: var(--use-case-note-size);
    color: var(--use-case-note-color);
    line-height: 1.5;
    word-break: break-word;
    padding-top: 10px;
  }

  @media screen and (max-width: 639px) {
    .use-case-card {
      padding: calc(var(--use-case-padding-y) * 0.8) calc(var(--use-case-padding-x) * 0.75);
    }
  }
{% endstylesheet %}

<div
  id="block-{{ block.id }}"
  class="use-case-list-block spacing-style{% if block_settings.background_color != blank or block_settings.text_color != blank %} color-custom-{{ block.id }}{% endif %}"
  style="
    {% if block_settings.type_preset == 'custom' %}
      {% render 'typography-style', settings: block_settings %}
    {% else %}
      --font-family: var(--font-{{ block_settings.type_preset }}--family);
    {% endif %}
    {% render 'spacing-style', settings: block_settings %}
    {% render 'border-override', settings: block_settings %}
  "
  {{ block.shopify_attributes }}
>
  <div class="use-case-list__grid">
    {% for item in items %}
      {% liquid
        assign badge_val = item.badge.value | default: item.badge
        assign title_val = item.title.value | default: item.title
        assign desc_val = item.description | metafield_tag
        if desc_val == blank or desc_val contains 'metafield-multi_line_text_field' or desc_val contains 'metafield-single_line_text_field'
          assign desc_val = item.description.value | default: item.description
        endif

        assign note_val = item.note | metafield_tag
        if note_val == blank or note_val contains 'metafield-multi_line_text_field' or note_val contains 'metafield-single_line_text_field'
          assign note_val = item.note.value | default: item.note
        endif
      %}

      <div class="use-case-card border-style">
        {% if badge_val != blank %}
          <div class="use-case-card__badge-wrap">
            <span class="use-case-card__badge">{{ badge_val }}</span>
          </div>
        {% endif %}

        {% if title_val != blank %}
          <h3 class="use-case-card__title">{{ title_val }}</h3>
        {% endif %}

        {% if desc_val != blank %}
          <div class="use-case-card__description rte">
            {{ desc_val }}
          </div>
        {% endif %}

        {% if block_settings.show_divider %}
          <div class="use-case-card__divider"></div>
        {% endif %}

        {% if note_val != blank %}
          <div class="use-case-card__note">
            {{ note_val }}
          </div>
        {% endif %}
      </div>
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "Use Case List",
  "class": "use-case-list-block",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Metaobject Selection"
    },
    {
      "type": "metaobject",
      "metaobject_type": "use_case",
      "id": "use_case",
      "label": "Specific Use Case"
    },
    {
      "type": "header",
      "content": "Grid Layout"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Desktop Columns",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Mobile Columns",
      "options": [
        { "value": "1", "label": "1 Column" },
        { "value": "2", "label": "2 Columns" }
      ],
      "default": "1"
    },
    {
      "type": "range",
      "id": "columns_gap",
      "label": "Desktop Column Gap",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "columns_gap_mobile",
      "label": "Mobile Column Gap",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "rows_gap",
      "label": "Row Gap",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "header",
      "content": "Badge Styling"
    },
    {
      "type": "color",
      "id": "badge_bg_color",
      "label": "Badge background color"
    },
    {
      "type": "color",
      "id": "badge_color",
      "label": "Badge text color"
    },
    {
      "type": "range",
      "id": "badge_font_size",
      "label": "Badge font size",
      "min": 9,
      "max": 18,
      "step": 1,
      "unit": "px",
      "default": 11
    },
    {
      "type": "header",
      "content": "Title & Description Styling"
    },
    {
      "type": "range",
      "id": "title_font_size",
      "label": "Title font size",
      "min": 12,
      "max": 48,
      "step": 1,
      "unit": "px",
      "default": 18
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Title color"
    },
    {
      "type": "range",
      "id": "desc_font_size",
      "label": "Description font size",
      "min": 10,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "color",
      "id": "desc_color",
      "label": "Description color"
    },
    {
      "type": "header",
      "content": "Divider Settings"
    },
    {
      "type": "checkbox",
      "id": "show_divider",
      "label": "Show divider line",
      "default": true
    },
    {
      "type": "color",
      "id": "divider_color",
      "label": "Divider color"
    },
    {
      "type": "range",
      "id": "divider_spacing",
      "label": "Divider spacing",
      "min": 4,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "header",
      "content": "Note Settings"
    },
    {
      "type": "color",
      "id": "note_color",
      "label": "Note text color"
    },
    {
      "type": "range",
      "id": "note_font_size",
      "label": "Note font size",
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 13
    },
    {
      "type": "header",
      "content": "Card Layout & Styling"
    },
    {
      "type": "color",
      "id": "card_bg_color",
      "label": "Card background color"
    },
    {
      "type": "color",
      "id": "card_border_color",
      "label": "Card border color"
    },
    {
      "type": "range",
      "id": "card_border_width",
      "label": "Card border width",
      "min": 0,
      "max": 10,
      "step": 1,
      "unit": "px",
      "default": 1
    },
    {
      "type": "range",
      "id": "card_border_radius",
      "label": "Card corner radius",
      "min": 0,
      "max": 30,
      "step": 1,
      "unit": "px",
      "default": 6
    },
    {
      "type": "range",
      "id": "card_padding_y",
      "label": "Card vertical padding",
      "min": 8,
      "max": 60,
      "step": 1,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "card_padding_x",
      "label": "Card horizontal padding",
      "min": 8,
      "max": 60,
      "step": 1,
      "unit": "px",
      "default": 24
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Text alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "header",
      "content": "Appearance & Preset"
    },
    {
      "type": "select",
      "id": "type_preset",
      "label": "Typography preset",
      "options": [
        { "value": "body", "label": "Body" },
        { "value": "heading", "label": "Heading" },
        { "value": "subheading", "label": "Subheading" },
        { "value": "custom", "label": "Custom" }
      ],
      "default": "custom"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Block background color"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Block text color"
    },
    {
      "type": "header",
      "content": "t:content.borders"
    },
    {
      "type": "select",
      "id": "border",
      "label": "t:settings.border",
      "options": [
        { "value": "none", "label": "t:options.none" },
        { "value": "solid", "label": "Solid" },
        { "value": "dashed", "label": "Dashed" },
        { "value": "dotted", "label": "Dotted" }
      ],
      "default": "none"
    },
    {
      "type": "range",
      "id": "border_width",
      "label": "t:settings.border_width",
      "min": 0,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 1,
      "visible_if": "{{ block.settings.border != 'none' }}"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "t:settings.border_color",
      "placeholder": "t:settings.default",
      "visible_if": "{{ block.settings.border != 'none' }}"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "t:settings.border_radius",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "t:settings.left",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "t:settings.right",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "Custom CSS"
    },
    {
      "type": "textarea",
      "id": "custom_css",
      "label": "Custom CSS",
      "info": "Custom CSS applied to this Use Case List block."
    }
  ],
  "presets": [
    {
      "name": "Use Case List"
    }
  ]
}
{% endschema %}
