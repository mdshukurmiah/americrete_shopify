{% liquid
  assign block_settings = block.settings
-%}

{% style %}
  .advanced-tabs--{{ block.id }} {
    --tabs-heading-color: {{ block_settings.color_heading | default: '#7b120c' }};
    --tabs-text-color: {{ block_settings.color_text | default: '#555555' }};
    --tabs-accent-color: {{ block_settings.color_accent | default: '#7b120c' }};
    --tabs-active-text-color: {{ block_settings.color_active_text | default: '#ffffff' }};
    --tabs-media-radius: {{ block_settings.media_radius | default: 0 }}px;
    --tabs-tab-radius: {{ block_settings.tab_radius | default: 6 }}px;
    --tabs-aspect-ratio: {{ block_settings.media_aspect_ratio | default: '16 / 9' }};

    --tabs-tab-size: {{ block_settings.tab_font_size | default: 26 }}px;
    --tabs-tab-size-mobile: {{ block_settings.mobile_tab_font_size | default: 17 }}px;
    --tabs-heading-size: {{ block_settings.heading_font_size | default: 38 }}px;
    --tabs-heading-size-mobile: {{ block_settings.mobile_heading_font_size | default: 26 }}px;
    --tabs-text-size: {{ block_settings.text_font_size | default: 26 }}px;
    --tabs-text-size-mobile: {{ block_settings.mobile_text_font_size | default: 17 }}px;
    --tabs-note-size: {{ block_settings.note_font_size | default: 26 }}px;
    --tabs-note-size-mobile: {{ block_settings.mobile_note_font_size | default: 16 }}px;

    background: {% if block_settings.gradient_background != blank and block_settings.gradient_background != 'rgba(0,0,0,0)' %}{{ block_settings.gradient_background }}{% elsif block_settings.color_background != blank and block_settings.color_background != 'rgba(0,0,0,0)' %}{{ block_settings.color_background }}{% else %}transparent{% endif %};
  }
{% endstyle %}

{% stylesheet %}
  .advanced-tabs {
    display: block;
    width: 100%;
  }

  .advanced-tabs .tabs-section__nav {
    display: grid;
    grid-template-columns: repeat(var(--tabs-count, 4), minmax(0, 1fr));
    gap: 0;
    margin: 0 0 40px;
    padding: 8px;
    border: 1px solid var(--tabs-accent-color);
    border-radius: var(--tabs-tab-radius);
  }

  .advanced-tabs .tabs-section__tab {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 45px;
    padding: 0px 18px;
    border: 0;
    border-radius: 0;
    background: transparent;
    color: var(--tabs-accent-color);
    font: inherit;
    font-size: var(--tabs-tab-size-mobile);
    line-height: 1.15;
    font-weight: 700;
    text-align: center;
    cursor: pointer;
    transition: background-color 0.2s ease, color 0.2s ease;
  }

  @media (min-width: 750px) {
    .advanced-tabs .tabs-section__tab {
      font-size: var(--tabs-tab-size);
    }
  }

  .advanced-tabs .tabs-section__tab.is-active {
    background: var(--tabs-accent-color);
    color: var(--tabs-active-text-color);
    border-radius: calc(var(--tabs-tab-radius) - 2px);
  }

  .advanced-tabs .tabs-section__panel {
    display: none;
  }

  .advanced-tabs .tabs-section__panel.is-active {
    display: block;
  }

  .advanced-tabs .tabs-section__layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: 34px;
    align-items: center;
  }

  @media (min-width: 990px) {
    .advanced-tabs .tabs-section__layout {
      grid-template-columns: minmax(320px, 0.98fr) minmax(320px, 1.02fr);
      gap: 52px;
    }
  }

  .advanced-tabs .tabs-section__media {
    position: relative;
    overflow: hidden;
    border-radius: var(--tabs-media-radius);
    background: rgb(from var(--tabs-accent-color) r g b / 0.08);
  }

  .advanced-tabs .tabs-section__media img,
  .advanced-tabs .tabs-section__media .placeholder-svg {
    display: block;
    width: 100%;
    aspect-ratio: var(--tabs-aspect-ratio);
    height: auto;
    object-fit: cover;
  }

  .advanced-tabs .tabs-section__media .hero-video-block,
  .advanced-tabs .tabs-section__media .hero-video-wrapper,
  .advanced-tabs .tabs-section__media .element-video,
  .advanced-tabs .tabs-section__media video-media,
  .advanced-tabs .tabs-section__media video,
  .advanced-tabs .tabs-section__media iframe {
    border-radius: inherit;
    overflow: hidden;
  }

  .advanced-tabs .tabs-section__media .element-video,
  .advanced-tabs .tabs-section__media video-media {
    aspect-ratio: var(--tabs-aspect-ratio);
  }

  .advanced-tabs .tabs-section__content {
    max-width: 820px;
  }

  .advanced-tabs .tabs-section__heading {
    margin: 0 0 28px;
    color: var(--tabs-heading-color);
    line-height: 1.08;
  }

  .advanced-tabs .tabs-section__text {
    color: var(--tabs-text-color);
    font-size: var(--tabs-text-size-mobile);
    line-height: 1.45;
    font-weight: 600;
  }

  .advanced-tabs .tabs-section__text * {
    font-size: var(--tabs-text-size-mobile);
    font-weight: 400;
  }

  .advanced-tabs .tabs-section__heading {
    font-size: var(--tabs-heading-size-mobile);
  }

  @media (min-width: 750px) {
    .advanced-tabs .tabs-section__text,
    .advanced-tabs .tabs-section__text * {
      font-size: var(--tabs-text-size);
    }
    .advanced-tabs .tabs-section__heading {
      font-size: var(--tabs-heading-size);
    }
  }

  .advanced-tabs .tabs-section__text strong {
    font-weight: 800;
  }

  .advanced-tabs .tabs-section__text p:last-child,
  .advanced-tabs .tabs-section__note p:last-child {
    margin-bottom: 0;
  }

  .advanced-tabs .tabs-section__note {
    margin-top: 28px;
    color: var(--tabs-text-color);
    font-size: var(--tabs-note-size-mobile);
    line-height: 1.35;
    font-style: italic;
  }

  .advanced-tabs .tabs-section__note * {
    font-size: var(--tabs-note-size-mobile);
  }

  @media (min-width: 750px) {
    .advanced-tabs .tabs-section__note,
    .advanced-tabs .tabs-section__note * {
      font-size: var(--tabs-note-size);
    }
  }

  @media only screen and (max-width: 989px) {
    .advanced-tabs .tabs-section__nav {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      margin-bottom: 25px;
    }
  }

  @media only screen and (max-width: 589px) {
    .advanced-tabs .tabs-section__nav {
      display: flex;
      flex-wrap: wrap;
      padding: 6px;
      margin-bottom: 20px;
    }

    .advanced-tabs .tabs-section__tab {
      flex: 0 0 100%;
      min-height: 54px;
      padding: 10px 14px;
    }

    .advanced-tabs .tabs-section__heading {
      margin-bottom: 18px;
    }
  }
{% endstylesheet %}

<advanced-tabs
  class="
    advanced-tabs
    advanced-tabs--{{ block.id }}
    spacing-style
    size-style
  "
  style="{% render 'spacing-style', settings: block_settings %}{% render 'size-style', settings: block_settings %}"
  data-tabs-section
  {{ block.shopify_attributes }}
>
  <div class="page-width">
    <div class="tabs-section__nav" role="tablist" aria-label="{{ block_settings.accessibility_label | escape }}">
      <!-- Dynamically generated buttons go here -->
    </div>

    <div class="tabs-section__panels">
      {% content_for 'blocks' %}
    </div>
  </div>
</advanced-tabs>

<script>
  (function () {
    class AdvancedTabs extends HTMLElement {
      connectedCallback() {
        this.nav = this.querySelector('.tabs-section__nav');
        this.panelsContainer = this.querySelector('.tabs-section__panels');
        this.init();

        // Listen for block selection in editor
        this._onBlockSelect = this.onBlockSelect.bind(this);
        document.addEventListener('shopify:block:select', this._onBlockSelect);
      }

      disconnectedCallback() {
        document.removeEventListener('shopify:block:select', this._onBlockSelect);
      }

      init() {
        if (!this.nav || !this.panelsContainer) return;

        // Clear any existing dynamically generated tabs
        this.nav.innerHTML = '';

        this.panels = Array.from(this.querySelectorAll('[data-tabs-panel]'));
        if (this.panels.length === 0) return;

        this.style.setProperty('--tabs-count', this.panels.length);

        this.panels.forEach((panel, index) => {
          const label = panel.getAttribute('data-tab-label') || `Tab ${index + 1}`;
          const id = panel.getAttribute('data-tab-id');

          const button = document.createElement('button');
          button.type = 'button';
          button.className = `tabs-section__tab${index === 0 ? ' is-active' : ''}`;
          button.id = `tab-button-${id}`;
          button.setAttribute('role', 'tab');
          button.setAttribute('aria-selected', index === 0 ? 'true' : 'false');
          button.setAttribute('aria-controls', `tab-panel-${id}`);
          button.textContent = label;

          button.addEventListener('click', () => this.activateTab(id));
          this.nav.appendChild(button);

          // Initial visibility
          if (index === 0) {
            panel.classList.add('is-active');
            panel.hidden = false;
          } else {
            panel.classList.remove('is-active');
            panel.hidden = true;
          }
        });
      }

      activateTab(targetId) {
        this.panels.forEach((panel) => {
          const id = panel.getAttribute('data-tab-id');
          const isActive = id === targetId;
          panel.classList.toggle('is-active', isActive);
          panel.hidden = !isActive;
        });

        const buttons = Array.from(this.nav.querySelectorAll('[role="tab"]'));
        buttons.forEach((button) => {
          const id = button.id.replace('tab-button-', '');
          const isActive = id === targetId;
          button.classList.toggle('is-active', isActive);
          button.setAttribute('aria-selected', isActive ? 'true' : 'false');
        });
      }

      onBlockSelect(event) {
        const blockId = event.detail.blockId;
        if (blockId) {
          const panel = this.querySelector(`[data-tab-id="${blockId}"]`);
          if (panel) {
            this.activateTab(blockId);
          }
        }
      }
    }

    if (!customElements.get('advanced-tabs')) {
      customElements.define('advanced-tabs', AdvancedTabs);
    }
  })();
</script>

{% schema %}
{
  "name": "Advanced tabs",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "accessibility_label",
      "label": "Accessibility label",
      "default": "Tabbed content"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "media_aspect_ratio",
      "label": "Image aspect ratio",
      "default": "16 / 9",
      "options": [
        {
          "value": "16 / 9",
          "label": "Landscape (16/9)"
        },
        {
          "value": "1 / 1",
          "label": "Square (1/1)"
        },
        {
          "value": "9 / 16",
          "label": "Portrait (9/16)"
        }
      ]
    },
    {
      "type": "range",
      "id": "media_radius",
