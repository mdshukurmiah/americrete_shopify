{% liquid
  assign block_settings = block.settings
  assign icon_class = 'icon-with-text__icon icon-with-text-icon-' | append: block.id
%}

{% style %}
  {% if block_settings.icon_color != blank %}
    .icon-with-text-icon-{{ block.id }} {
      color: {{ block_settings.icon_color }};
      fill: currentColor;
    }
  {% endif %}

  .icon-with-text--{{ block.id }} {
    --iwt-layout: {{ block_settings.layout | default: 'row' }};
    --iwt-gap: {{ block_settings.gap | default: 12 }}px;
    --iwt-gap-mobile: {{ block_settings.gap_mobile | default: block_settings.gap | default: 8 }}px;
    --iwt-icon-size: {{ block_settings.icon_size | default: 24 }}px;
    --iwt-align: {{ block_settings.alignment | default: 'flex-start' }};
    --iwt-vertical-align: {{ block_settings.vertical_alignment | default: 'center' }};
    --iwt-font-size: {{ block_settings.font_size | default: '1rem' }};
    --iwt-font-size-mobile: {{ block_settings.font_size_mobile | default: block_settings.font_size | default: '1rem' }};
    --iwt-text-color: {{ block_settings.text_color | default: 'inherit' }};
    {% render 'spacing-style', settings: block_settings %}
  }
{% endstyle %}

<div
  class="icon-with-text-block icon-with-text--{{ block.id }} spacing-style"
  {{ block.shopify_attributes }}
>
  {% capture icon_markup %}
    <div class="icon-with-text__icon-wrapper">
      {% render 'icon-or-image',
        icon: block_settings.icon,
        image_upload: block_settings.image_upload,
        width: block_settings.icon_size,
        class_name: icon_class
      %}
    </div>
  {% endcapture %}

  {%- if block_settings.link != blank -%}
    <a
      href="{{ block_settings.link }}"
      class="icon-with-text__link"
      {% if block_settings.open_in_new_tab %}
        target="_blank" rel="noopener"
      {% endif %}
    >
      {{ icon_markup }}
      {% if block_settings.text != blank %}
        <div class="icon-with-text__content">
          {{ block.settings.text }}
        </div>
      {% endif %}
    </a>
  {%- else -%}
    <div class="icon-with-text__inner">
      {{ icon_markup }}
      {% if block_settings.text != blank %}
        <div class="icon-with-text__content">
          {{ block.settings.text }}
        </div>
      {% endif %}
    </div>
  {%- endif -%}
</div>

{% stylesheet %}
  .icon-with-text-block {
    display: flex;
    width: fit-content;
  }

  .icon-with-text__inner,
  .icon-with-text__link {
    display: flex;
    flex-direction: var(--iwt-layout, row);
    gap: var(--iwt-gap, 12px);
    align-items: var(--iwt-vertical-align, center);
    justify-content: var(--iwt-align, flex-start);
    width: fit-content;
    color: var(--iwt-text-color);
    text-decoration: none;
  }

  .icon-with-text__icon-wrapper {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: var(--iwt-icon-size);
    height: var(--iwt-icon-size);
  }

  .icon-with-text__icon {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .icon-with-text__content {
    font-size: var(--iwt-font-size);
    color: inherit;
    line-height: 1.4;

    p {
      margin: 0;
    }
  }

  @media screen and (max-width: 749px) {
    .icon-with-text__inner,
    .icon-with-text__link {
      gap: var(--iwt-gap-mobile, var(--iwt-gap, 8px));
    }
    .icon-with-text__content {
      font-size: var(--iwt-font-size-mobile, var(--iwt-font-size));
    }
  }
{% endstylesheet %}

