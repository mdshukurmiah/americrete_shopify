{% liquid
  assign block_settings = block.settings
%}

{% style %}
  #block-{{ block.id }} .compare-table-v3 {
    background: {% if block_settings.gradient_background != blank and block_settings.gradient_background != 'rgba(0,0,0,0)' %}{{ block_settings.gradient_background }}{% elsif block_settings.color_background != blank and block_settings.color_background != 'rgba(0,0,0,0)' %}{{ block_settings.color_background }}{% else %}#23310f{% endif %};
    color: {{ block_settings.color_text | default: '#ffffff' }};
  }

  {% if block_settings.gradient_highlight != blank %}
    #block-{{ block.id }} .highlight_words {
      background-image: {{ block_settings.gradient_highlight }};
      background-clip: text;
      -webkit-text-fill-color: transparent;
      display: inline-block;
    }
  {% else %}
    #block-{{ block.id }} .highlight_words {
      color: {{ block_settings.color_highlight | default: '#f4e7b6' }};
    }
  {% endif %}

  #block-{{ block.id }} .compare-table-v3__layout {
    display: flex;
    justify-content: center;
    align-items: center;
  }

  #block-{{ block.id }} .compare-table-v3__table-wrap {
    position: relative;
    width: 100%;
    max-width: {{ block_settings.table_max_width | default: 600 }}px;
  }

  #block-{{ block.id }} .compare-table-v3__table .compare-table-v3__header-wrap,  #block-{{ block.id }} .compare-table-v3__table .compare-table-v3__row  {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 8px;
  }

  #block-{{ block.id }} .compare-table-v3__column {
    position: relative;
    overflow: visible;
  }

  #block-{{ block.id }} .compare-table-v3__column.left {
    background: {{ block_settings.color_left_column | default: '#657a2b' }};
    color: {{ block_settings.color_left_text | default: '#ffffff' }};
    min-height: {{ block_settings.row_min_height | default: 86 }}px;
    padding: 18px 20px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
  }

  #block-{{ block.id }} .compare-table-v3__column.right {
    background: {{ block_settings.color_right_column | default: '#f5f4f1' }};
    color: {{ block_settings.color_right_text | default: '#1d1d1d' }};
    min-height: {{ block_settings.row_min_height | default: 86 }}px;
    padding: 18px 20px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
  }

  #block-{{ block.id }} .compare-table-v3__floating-image {
    position: absolute;
    left: 50%;
    bottom: calc(100% - 16px);
    transform: translateX(-50%);
    z-index: 2;
    width: min(100%, {{ block_settings.column_image_width | default: 120 }}px);
    pointer-events: none;
  }

  #block-{{ block.id }} .compare-table-v3__floating-image img {
    display: block;
    width: 100%;
    height: auto;
  }

  #block-{{ block.id }} .compare-table-v3__header {
    text-align: center;
  }

  #block-{{ block.id }} .compare-table-v3__column-title {
    margin: 0;
    font-size: 22px;
    line-height: 1.15;
    font-weight: 500;
    text-transform: uppercase;
  }

  #block-{{ block.id }} .compare-table-v3__header-wrap .compare-table-v3__column.right .compare-table-v3__column-title {
    text-transform: none;
  }
  #block-{{ block.id }} .compare-table-v3__header-wrap .compare-table-v3__column{
    border-radius: {{ block_settings.table_radius | default: 6 }}px {{ block_settings.table_radius | default: 6 }}px 0 0;
    min-height: unset;
  }
  #block-{{ block.id }} .compare-table-v3__body-wrap .compare-table-v3__row:last-child .compare-table-v3__column{
    border-radius: 0 0 {{ block_settings.table_radius | default: 6 }}px {{ block_settings.table_radius | default: 6 }}px;
  }
  #block-{{ block.id }} .compare-table-v3__row {
    border-top: 1px solid {{ block_settings.color_row_divider | default: '#d9d5cb' }};
  }

  #block-{{ block.id }} .compare-table-v3__header + .compare-table-v3__row {
    border-top: 0;
  }

  #block-{{ block.id }} .compare-table-v3__cell-icon {
    width: {{ block_settings.row_icon_size | default: 28 }}px;
    height: {{ block_settings.row_icon_size | default: 28 }}px;
    margin-bottom: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: currentColor;
  }

  #block-{{ block.id }} .compare-table-v3__cell-icon svg,
  #block-{{ block.id }} .compare-table-v3__cell-icon img {
    display: block;
    width: 100%;
    height: 100%;
  }

  #block-{{ block.id }} .compare-table-v3__cell-icon img {
    object-fit: contain;
  }

  #block-{{ block.id }} .compare-table-v3__cell-icon svg {
    stroke: currentColor;
    fill: none;
    stroke-width: 1.7;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  #block-{{ block.id }} .compare-table-v3__cell-text {
    font-size: 16px;
    line-height: 1.3;
    font-weight: 500;
  }

  @media only screen and (max-width: 989px) {
    #block-{{ block.id }} .compare-table-v3__table-wrap {
      max-width: 760px;
      margin: 0 auto;
    }
  }

  @media only screen and (max-width: 589px) {

    #block-{{ block.id }} .compare-table-v3__table {
      gap: 6px;
    }

    #block-{{ block.id }} .compare-table-v3__column-title {
      font-size: 18px;
    }

    #block-{{ block.id }} .compare-table-v3__row {
    }

    #block-{{ block.id }} .compare-table-v3__cell-text {
      font-size: 14px;
    }
  }
{% endstyle %}

<div class="compare-table-v3" id="block-{{ block.id }}">
  <div class="page-width">
    <div class="compare-table-v3__layout">
      <div class="compare-table-v3__table-wrap" data-aos>
        <div class="compare-table-v3__table">
          <div class="compare-table-v3__header-wrap">
            <div class="compare-table-v3__column left">
              {% if block_settings.left_image != blank %}
                <div class="compare-table-v3__floating-image">
                  {{ block_settings.left_image | image_url: width: 800 | image_tag: loading: 'lazy' }}
                </div>
              {% endif %}
              {% if block_settings.left_title != blank %}
                <div class="compare-table-v3__header">
                  <h3 class="compare-table-v3__column-title">{{ block_settings.left_title }}</h3>
                </div>
              {% endif %}
            </div>
            <div class="compare-table-v3__column right">
              {% if block_settings.right_image != blank %}
                <div class="compare-table-v3__floating-image">
                  {{ block_settings.right_image | image_url: width: 800 | image_tag: loading: 'lazy' }}
                </div>
              {% endif %}
              {% if block_settings.right_title != blank %}
                <div class="compare-table-v3__header">
                  <h3 class="compare-table-v3__column-title">{{ block_settings.right_title }}</h3>
                </div>
              {% endif %}
            </div>
          </div>
          <div class="compare-table-v3__body-wrap">
            {% content_for 'blocks' %}
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

