      "label": "Card vertical padding",
      "min": 4,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "card_padding_x",
      "label": "Card horizontal padding",
      "min": 4,
      "max": 40,
      "step": 1,
      "unit": "px",
