{% liquid
  assign block_settings = block.settings

  assign raw_rating = block_settings.rating | default: 48
  if raw_rating > 5
    assign rating_float = raw_rating | times: 1.0 | divided_by: 10.0
  else
    assign rating_float = raw_rating | times: 1.0
  endif

  assign full_stars = rating_float | floor
  assign decimal_part = rating_float | minus: full_stars
%}

<style>
  .rating-bar--{{ block.id }} {
    --rb-star-color: {{ block_settings.star_color | default: '#8B4614' }};
    --rb-text-color: {{ block_settings.text_color | default: 'inherit' }};
    --rb-font-size: {{ block_settings.font_size | default: 13 }}px;
    --rb-font-size-mobile: {{ block_settings.font_size_mobile | default: block_settings.font_size | default: 13 }}px;
    --rb-star-size: {{ block_settings.star_size | default: 14 }}px;
    --rb-gap: {{ block_settings.gap_size | default: 6 }}px;
    --rb-star-gap: {{ block_settings.star_gap | default: 2 }}px;
    --rb-margin-top: {{ block_settings.margin_top | default: 0 }}px;
    --rb-margin-bottom: {{ block_settings.margin_bottom | default: 0 }}px;
    {% render 'spacing-style', settings: block_settings %}
  }
</style>

<div
  class="rating-bar-block rating-bar--{{ block.id }} spacing-style"
  {{ block.shopify_attributes }}
>
  <div class="rating-bar__stars">
    {%- comment -%} Full stars {%- endcomment -%}
    {%- for i in (1..full_stars) -%}
      <svg
        aria-hidden="true"
        focusable="false"
        class="rating-bar__star rating-bar__star--full"
        viewBox="0 0 24 24"
      >
        <path d="M12 2.5l2.94 5.96 6.58.96-4.76 4.64 1.12 6.56L12 17.52 6.12 20.62l1.12-6.56L2.48 9.42l6.58-.96L12 2.5z"/>
      </svg>
    {%- endfor -%}

    {%- comment -%} Half star if needed {%- endcomment -%}
    {%- if decimal_part >= 0.25 and decimal_part <= 0.75 -%}
      <svg
        aria-hidden="true"
        focusable="false"
        class="rating-bar__star rating-bar__star--half"
        viewBox="0 0 24 24"
      >
        <defs>
          <clipPath id="rb-star-half-{{ block.id }}">
            <rect x="0" y="0" width="12" height="24"></rect>
          </clipPath>
        </defs>
        <path class="rating-bar__outline" d="M12 2.5l2.94 5.96 6.58.96-4.76 4.64 1.12 6.56L12 17.52 6.12 20.62l1.12-6.56L2.48 9.42l6.58-.96L12 2.5z"/>
        <path class="rating-bar__fill" clip-path="url(#rb-star-half-{{ block.id }})" d="M12 2.5l2.94 5.96 6.58.96-4.76 4.64 1.12 6.56L12 17.52 6.12 20.62l1.12-6.56L2.48 9.42l6.58-.96L12 2.5z"/>
      </svg>
      {%- assign remaining_stars = 4 | minus: full_stars -%}
    {%- elsif decimal_part > 0.75 -%}
      <svg
        aria-hidden="true"
        focusable="false"
        class="rating-bar__star rating-bar__star--full"
        viewBox="0 0 24 24"
      >
        <path d="M12 2.5l2.94 5.96 6.58.96-4.76 4.64 1.12 6.56L12 17.52 6.12 20.62l1.12-6.56L2.48 9.42l6.58-.96L12 2.5z"/>
      </svg>
      {%- assign remaining_stars = 4 | minus: full_stars -%}
    {%- else -%}
      {%- assign remaining_stars = 5 | minus: full_stars -%}
    {%- endif -%}

    {%- comment -%} Empty stars {%- endcomment -%}
    {%- if remaining_stars > 0 -%}
      {%- for i in (1..remaining_stars) -%}
        <svg
          aria-hidden="true"
          focusable="false"
          class="rating-bar__star rating-bar__star--empty"
          viewBox="0 0 24 24"
        >
          <path d="M12 2.5l2.94 5.96 6.58.96-4.76 4.64 1.12 6.56L12 17.52 6.12 20.62l1.12-6.56L2.48 9.42l6.58-.96L12 2.5z"/>
        </svg>
      {%- endfor -%}
    {%- endif -%}
  </div>

  {% if block_settings.rating_number != blank or block_settings.review_count != blank %}
    <span class="rating-bar__text">
      {% if block_settings.rating_number != blank %}
        <b>{{ block_settings.rating_number }}</b>
      {% endif %}
      {% if block_settings.review_count != blank %}
        based on <b>{{ block_settings.review_count }}</b> {{ block_settings.review_text }}
      {% endif %}
    </span>
  {% endif %}
</div>

{% stylesheet %}
  .rating-bar-block {
    display: flex;
    align-items: center;
    gap: var(--rb-gap, 6px);
    font-size: var(--rb-font-size, 13px);
    line-height: 1;
    color: var(--rb-text-color, inherit);
    margin-top: var(--rb-margin-top, 0px);
    margin-bottom: var(--rb-margin-bottom, 0px);
  }

  .rating-bar__stars {
    display: flex;
    align-items: center;
    gap: var(--rb-star-gap, 2px);
    color: var(--rb-star-color, #8b4614);
    font-size: var(--rb-star-size, 14px);
    flex-shrink: 0;
  }

  .rating-bar__star {
    width: 1em;
    height: 1em;
    display: block;
    flex: 0 0 auto;
  }

  .rating-bar__star--full,
  .rating-bar__fill {
    fill: currentColor;
  }

  .rating-bar__star--empty,
  .rating-bar__outline {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.75;
    stroke-linejoin: round;
  }

  .rating-bar__text {
    line-height: 1.2;
  }

  @media screen and (max-width: 749px) {
    .rating-bar-block {
      font-size: var(--rb-font-size-mobile, var(--rb-font-size, 13px));
    }
  }
{% endstylesheet %}

