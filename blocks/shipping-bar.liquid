{% liquid
  assign block_settings = block.settings
  assign ship_days = block_settings.ship_days | default: 1
  assign location_text = block_settings.location_text
  assign blink_animation = block_settings.blink_animation
  assign blink_color = block_settings.blink_color | default: '#007f04'
  assign shipping_text_format = block_settings.shipping_text_formate | default: '[flag] Ships from [country]'
%}

<style>
  .shipping-bar--{{ block.id }} {
    --sb-bg: {{ block_settings.background_color | default: '#f3f4f6' }};
    --sb-text-color: {{ block_settings.text_color | default: 'inherit' }};
    --sb-blink-color: {{ blink_color }};
    --sb-font-size: {{ block_settings.font_size | default: 14 }}px;
    --sb-font-size-mobile: {{ block_settings.font_size_mobile | default: block_settings.font_size | default: 14 }};
    --sb-border-radius: {{ block_settings.border_radius | default: 6 }}px;
    --sb-margin-top: {{ block_settings.margin_top | default: 0 }}px;
    --sb-margin-bottom: {{ block_settings.margin_bottom | default: 0 }}px;
    {% render 'spacing-style', settings: block_settings %}
  }
</style>

<div
  class="shipping-bar-block shipping-bar--{{ block.id }} spacing-style"
  {{ block.shopify_attributes }}
>
  <div class="shipping-bar__inner">
    <div class="shipping-bar__info">
      <span
        class="shipping-bar__dot{% if blink_animation %} shipping-bar__dot--blink{% endif %}"
        aria-hidden="true"
      ></span>
      <div class="shipping-bar__date-text">
        <span>{{ block_settings.prefix_text }}</span>
        <span
          id="cstmdate-{{ block.id }}"
          class="shipping-bar__date"
        ></span>
        {% if location_text != blank %}
          <span> {{ location_text }}</span>
        {% endif %}
      </div>
    </div>

    {%- if block_settings.country_based_shipping -%}
      {{ 'country-flags.css' | asset_url | stylesheet_tag }}
      <div class="shipping-bar__country">
        {%- assign flag_html = '<span class="currency-flag-wrapper"><span class="currency-flag currency-flag--'
          | append: localization.country.iso_code
          | downcase
          | append: '" aria-hidden="true"></span></span>'
        -%}
        {%- assign country_code = localization.country.iso_code -%}
        {%- if country_code == 'GB' -%}
          {%- assign country_code = 'UK' -%}
        {%- endif -%}
        {%- assign country_name = '<strong>' | append: country_code | append: '</strong>' -%}
        {{ shipping_text_format | replace: '[flag]', flag_html | replace: '[country]', country_name }}
      </div>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .shipping-bar-block {
    display: flex;
    width: 100%;
    margin-top: var(--sb-margin-top, 0px);
    margin-bottom: var(--sb-margin-bottom, 0px);
  }

  .shipping-bar__inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 10px;
    width: 100%;
    background: var(--sb-bg, #f3f4f6);
    border-radius: var(--sb-border-radius, 6px);
    padding: var(--padding-xs, 8px) var(--padding-sm, 12px);
    color: var(--sb-text-color, inherit);
    font-size: var(--sb-font-size, 14px);
  }

  .shipping-bar__info {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .shipping-bar__dot {
    min-width: 10px;
    height: 10px;
    width: 10px;
    border-radius: 50%;
    display: inline-block;
    background-color: var(--sb-blink-color, #007f04);
    flex-shrink: 0;
  }

  .shipping-bar__dot--blink {
    animation: shipping-dot-blink 1.5s infinite;
  }

  @keyframes shipping-dot-blink {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.4;
    }
  }

  .shipping-bar__date-text {
    line-height: 1.3;
    font-size: inherit;
  }

  .shipping-bar__date {
    font-weight: 700;
  }

  .shipping-bar__country {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: inherit;
    color: inherit;
  }

  .currency-flag-wrapper {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 20px;
    height: 20px;
    overflow: hidden;
    border-radius: 50%;
    flex-shrink: 0;
    vertical-align: middle;
  }

  @media screen and (max-width: 749px) {
    .shipping-bar__inner {
      font-size: var(--sb-font-size-mobile, var(--sb-font-size, 14px));
    }
    .currency-flag {
      width: 28px;
      height: 28px;
    }
  }
{% endstylesheet %}

<script>
  function calculateShippingDate{{ block.id | replace: '-', '_' }}(days, excludeWeekends, showDayName) {
    const today = new Date();
    const shippingDays = parseInt(days, 10) || 1;
    const shippingDate = new Date(today);

    if (excludeWeekends) {
      let daysAdded = 0;
      while (daysAdded < shippingDays) {
        shippingDate.setDate(shippingDate.getDate() + 1);
        const dayOfWeek = shippingDate.getDay();
        if (dayOfWeek !== 0 && dayOfWeek !== 6) {
          daysAdded += 1;
        }
      }
    } else {
      shippingDate.setDate(shippingDate.getDate() + shippingDays);
    }

    const options = {
      month: 'long',
      day: 'numeric'
    };

    if (showDayName) {
      options.weekday = 'short';
    }

    return shippingDate.toLocaleDateString('en-US', options);
  }

  document.addEventListener('DOMContentLoaded', function () {
    const dateElement = document.getElementById('cstmdate-{{ block.id }}');
    if (dateElement) {
      dateElement.innerText = calculateShippingDate{{ block.id | replace: '-', '_' }}(
        {{ ship_days }},
        {{ block_settings.excludes_weekends | default: false }},
        {{ block_settings.show_day_name | default: true }}
      );
    }
  });
</script>

