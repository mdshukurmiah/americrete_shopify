{% assign block_settings = block.settings %}

{% render 'contrast-override',
  background_color: block_settings.background_color,
  text_color: block_settings.text_color,
  section_id: block.id
%}

<div
  class="accordion accordion--{{ block.id }} accordion--{{ block_settings.icon }}{% if block_settings.icon_type == 'stacked' %} accordion--icon-stacked{% endif %} border-style spacing-style{% if block_settings.background_color != blank or block_settings.text_color != blank %} color-custom-{{ block.id }}{% endif %}{% if block_settings.background_color != blank %} accordion--custom-background{% endif %}{% if block_settings.dividers %} accordion--dividers{% endif %}{% if block_settings.type_preset == 'custom' %} custom-typography{% if block_settings.font_size != blank %} custom-font-size{% endif %}{% endif %}"
  style="
    {% if block_settings.type_preset == 'custom' %}
      {% render 'typography-style', settings: block_settings %}
    {% else %}
      --summary-font-family: var(--font-{{ block_settings.type_preset }}--family);
      --summary-font-style: var(--font-{{ block_settings.type_preset }}--style);
      --summary-font-weight: var(--font-{{ block_settings.type_preset }}--weight);
      --summary-font-size: var(--font-{{ block_settings.type_preset }}--size);
      --summary-font-line-height: var(--font-{{ block_settings.type_preset }}--line-height);
      --summary-font-case: var(--font-{{ block_settings.type_preset }}--case);
    {% endif %}
    {% if block_settings.icon_type == 'stacked' %}
      {% if block_settings.active_background_color != blank %}--accordion-active-bg: {{ block_settings.active_background_color }};{% endif %}
      {% if block_settings.inactive_background_color != blank %}--accordion-inactive-bg: {{ block_settings.inactive_background_color }};{% endif %}
      {% if block_settings.active_icon_color != blank %}--accordion-active-icon-color: {{ block_settings.active_icon_color }};{% endif %}
      {% if block_settings.inactive_icon_color != blank %}--accordion-inactive-icon-color: {{ block_settings.inactive_icon_color }};{% endif %}
    {% endif %}
    {% if block_settings.item_border != blank and block_settings.item_border != 'none' %}
      --item-border-style: {{ block_settings.item_border }};
      --item-border-width: {{ block_settings.item_border_width | default: 1 }}px;
      {% if block_settings.item_border_color != blank %}--item-border-color: {{ block_settings.item_border_color }};{% endif %}
    {% endif %}
    {% if block_settings.item_border_radius > 0 %}--item-border-radius: {{ block_settings.item_border_radius }}px;{% endif %}
    --item-gap: {{ block_settings.item_gap | default: 0 }}px;
    {% if block_settings.item_padding_top > 0 %}--item-padding-top: {{ block_settings.item_padding_top }}px;{% endif %}
    {% if block_settings.item_padding_bottom > 0 %}--item-padding-bottom: {{ block_settings.item_padding_bottom }}px;{% endif %}
    {% if block_settings.item_padding_left > 0 %}--item-padding-left: {{ block_settings.item_padding_left }}px;{% endif %}
    {% if block_settings.item_padding_right > 0 %}--item-padding-right: {{ block_settings.item_padding_right }}px;{% endif %}
    {% render 'spacing-style', settings: block_settings %}
    {% render 'border-override', settings: block_settings %}
    {% if block_settings.divider_color != blank %} --color-border: {{ block_settings.divider_color }};{% endif %}
  "
  {{ block.shopify_attributes }}
>
  {% content_for 'blocks' %}
</div>

{% render 'accordion-styles' %}

