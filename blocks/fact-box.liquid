        {
          "value": "1.125rem",
          "label": "18px"
        },
        {
          "value": "1.25rem",
          "label": "20px"
        },
        {
          "value": "1.375rem",
          "label": "22px"
        },
        {
          "value": "1.5rem",
          "label": "24px"
        },
        {
          "value": "1.75rem",
          "label": "28px"
        }
      ],
      "default": "1.375rem"
    },
    {
      "type": "select",
      "id": "value_weight",
      "label": "Value font weight",
      "options": [
        {
          "value": "600",
          "label": "t:options.semibold"
        },
        {
          "value": "700",
          "label": "t:options.bold"
        },
        {
          "value": "800",
          "label": "800"
        }
      ],
      "default": "800"
    },
    {
      "type": "header",
      "content": "t:content.borders"
    },
    {
      "type": "select",
      "id": "border",
      "label": "t:settings.border",
      "options": [
        {
          "value": "none",
          "label": "t:options.none"
        },
        {
          "value": "solid",
          "label": "Solid"
        },
        {
          "value": "dashed",
          "label": "Dashed"
        },
        {
          "value": "dotted",
          "label": "Dotted"
        }
      ],
      "default": "none"
    },
    {
      "type": "range",
      "id": "border_width",
      "label": "t:settings.border_width",
      "min": 0,
      "max": 20,
      "step": 1,
      "unit": "px",
