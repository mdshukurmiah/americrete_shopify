{%- liquid
  assign block_settings = block.settings

  assign separator = '/'
  if block_settings.separator == 'custom'
    assign separator = block_settings.custom_separator
  elsif block_settings.separator != blank
    assign separator = block_settings.separator
  endif

  assign flex_alignment = 'flex-start'
  if block_settings.alignment == 'center'
    assign flex_alignment = 'center'
  elsif block_settings.alignment == 'right'
    assign flex_alignment = 'flex-end'
  endif
-%}

<nav
  class="breadcrumb-nav spacing-style {% if block_settings.type_preset == 'custom' %}custom-typography custom-font-size{% endif %}"
  aria-label="Breadcrumb"
  style="
    {% render 'spacing-padding', settings: block_settings %}
    {% render 'typography-style', settings: block_settings %}
    {% if block_settings.text_color != blank %}
      --breadcrumb-text-color: {{ block_settings.text_color }};
      --breadcrumb-text-color-rgb: {{ block_settings.text_color.rgb }};
    {% endif %}
    {% if block_settings.active_color != blank %}
      --breadcrumb-active-color: {{ block_settings.active_color }};
    {% endif %}
    {% if block_settings.separator_color != blank %}
      --breadcrumb-separator-color: {{ block_settings.separator_color }};
    {% endif %}
    {% if block_settings.hover_color != blank %}
      --breadcrumb-hover-color: {{ block_settings.hover_color }};
    {% endif %}
    --breadcrumb-gap: {{ block_settings.gap }}px;
    --breadcrumb-alignment: {{ flex_alignment }};
    --width: {{ block_settings.width }};
    --max-width: var(--max-width--body-{{ block_settings.max_width }});
  "
  {{ block.shopify_attributes }}
>
  <ol class="breadcrumb-list">
    <li class="breadcrumb-item">
      <a href="{{ routes.root_url }}">{{ block_settings.home_label | default: 'Home' }}</a>
    </li>

    {%- if template.name == 'page' -%}
      <li class="breadcrumb-separator" aria-hidden="true">{{ separator }}</li>
      <li class="breadcrumb-item breadcrumb-item--active">
        <span>{{ page.title }}</span>
      </li>

    {%- elsif template.name == 'collection' and collection.handle -%}
      {%- if block_settings.include_shop_link -%}
        <li class="breadcrumb-separator" aria-hidden="true">{{ separator }}</li>
        <li class="breadcrumb-item">
          <a href="{{ block_settings.shop_url | default: routes.collections_url }}">
            {{- block_settings.shop_label | default: 'Shop' -}}
          </a>
        </li>
      {%- endif -%}
      <li class="breadcrumb-separator" aria-hidden="true">{{ separator }}</li>
      <li class="breadcrumb-item breadcrumb-item--active">
        <span>{{ collection.title }}</span>
      </li>

    {%- elsif template.name == 'list-collections' -%}
      <li class="breadcrumb-separator" aria-hidden="true">{{ separator }}</li>
      <li class="breadcrumb-item breadcrumb-item--active">
        <span>{{ block_settings.shop_label | default: 'Collections' }}</span>
      </li>

    {%- elsif template.name == 'product' -%}
      {%- if block_settings.include_shop_link -%}
        <li class="breadcrumb-separator" aria-hidden="true">{{ separator }}</li>
        <li class="breadcrumb-item">
          <a href="{{ block_settings.shop_url | default: routes.collections_url }}">
            {{- block_settings.shop_label | default: 'Shop' -}}
          </a>
        </li>
      {%- endif -%}
      {%- assign current_collection = collection | default: product.collections.first -%}
      {%- if current_collection -%}
        <li class="breadcrumb-separator" aria-hidden="true">{{ separator }}</li>
        <li class="breadcrumb-item">
          <a href="{{ current_collection.url }}">{{ current_collection.title }}</a>
        </li>
      {%- endif -%}
      <li class="breadcrumb-separator" aria-hidden="true">{{ separator }}</li>
      <li class="breadcrumb-item breadcrumb-item--active">
        <span>{{ product.title }}</span>
      </li>

    {%- elsif template.name == 'blog' -%}
      <li class="breadcrumb-separator" aria-hidden="true">{{ separator }}</li>
      <li class="breadcrumb-item breadcrumb-item--active">
        <span>{{ blog.title }}</span>
      </li>

    {%- elsif template.name == 'article' -%}
      <li class="breadcrumb-separator" aria-hidden="true">{{ separator }}</li>
      <li class="breadcrumb-item">
        <a href="{{ blog.url }}">{{ blog.title }}</a>
      </li>
      <li class="breadcrumb-separator" aria-hidden="true">{{ separator }}</li>
      <li class="breadcrumb-item breadcrumb-item--active">
        <span>{{ article.title }}</span>
      </li>

    {%- elsif template.name == 'search' -%}
      <li class="breadcrumb-separator" aria-hidden="true">{{ separator }}</li>
      <li class="breadcrumb-item breadcrumb-item--active">
        <span>Search</span>
      </li>

    {%- elsif template.name == 'cart' -%}
      <li class="breadcrumb-separator" aria-hidden="true">{{ separator }}</li>
      <li class="breadcrumb-item breadcrumb-item--active">
        <span>Cart</span>
      </li>

    {%- else -%}
      <li class="breadcrumb-separator" aria-hidden="true">{{ separator }}</li>
      <li class="breadcrumb-item breadcrumb-item--active">
        <span>{{ page_title }}</span>
      </li>
    {%- endif -%}
  </ol>
</nav>

{% stylesheet %}
  .breadcrumb-nav {
    display: flex;
    justify-content: var(--breadcrumb-alignment, flex-start);
    width: var(--width, fit-content);
    max-width: var(--max-width, 100%);
    color: var(--breadcrumb-text-color, var(--color-foreground-secondary, #757575));

    /* Inherit custom typography variables if custom preset is selected */
    font-family: var(--font-family, inherit);
    font-weight: var(--font-weight, inherit);
    font-size: var(--font-size, inherit);
    text-transform: var(--text-transform, inherit);
    text-wrap: var(--text-wrap, inherit);
    line-height: var(--line-height, inherit);
    letter-spacing: var(--letter-spacing, inherit);
  }

  @media screen and (max-width: 749px) {
    .breadcrumb-nav {
      font-size: var(--font-size-mobile, var(--font-size, inherit));
    }
  }

  .breadcrumb-list {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    list-style: none;
    padding: 0;
    margin: 0;
    gap: var(--breadcrumb-gap, 12px);
  }

  .breadcrumb-item {
    display: inline-flex;
    align-items: center;
  }

  .breadcrumb-item a,
  .breadcrumb-item span,
  .breadcrumb-separator {
    font-family: inherit;
    font-weight: inherit;
    font-size: inherit;
    text-transform: inherit;
    line-height: inherit;
    letter-spacing: inherit;
  }

  .breadcrumb-item a {
    color: inherit;
    text-decoration: none;
    transition: color 0.15s ease-in-out;
  }

  .breadcrumb-item a:hover {
    color: var(--breadcrumb-hover-color, var(--color-foreground, #000000));
  }

  .breadcrumb-separator {
    display: inline-flex;
    align-items: center;
    user-select: none;
    color: var(--breadcrumb-separator-color, var(--breadcrumb-text-color, var(--color-foreground-secondary, #757575)));
    opacity: 0.8;
  }

  .breadcrumb-item--active {
    font-weight: var(--font-weight-bold, 700);
    color: var(--breadcrumb-active-color, var(--color-foreground, #000000));
  }
{% endstylesheet %}

