{% liquid
  assign block_settings = block.settings
  assign target_product = block_settings.product | default: product
  assign a_images_value = null

  # 1. Check custom metafield key setting if specified
  if block_settings.metafield_key != blank and block_settings.metafield_key contains '.'
    assign key_parts = block_settings.metafield_key | strip | split: '.'
    assign custom_ns = key_parts[0]
    assign custom_key = key_parts[1]
    assign custom_mf = target_product.metafields[custom_ns][custom_key]
    if custom_mf.value != blank
      assign a_images_value = custom_mf.value
    elsif custom_mf != blank
      assign a_images_value = custom_mf
    endif
  endif

  # 2. Check primary default: custom.a_images (configured in Shopify metafields)
  if a_images_value == blank or a_images_value == null
    assign custom_a_images = target_product.metafields.custom.a_images
    if custom_a_images.value != blank
      assign a_images_value = custom_a_images.value
    elsif custom_a_images != blank
      assign a_images_value = custom_a_images
    endif
  endif

  # 3. Check fallbacks: custom.a_plus_images / custom.a_plus_contents
  if a_images_value == blank or a_images_value == null
    if target_product.metafields.custom.a_plus_images.value != blank
      assign a_images_value = target_product.metafields.custom.a_plus_images.value
    elsif target_product.metafields.custom.a_plus_contents.value != blank
      assign a_images_value = target_product.metafields.custom.a_plus_contents.value
    endif
  endif

  assign has_images = false
  if a_images_value != blank
    if a_images_value.first != blank or a_images_value.size > 0
      assign has_images = true
    elsif a_images_value.src != blank or a_images_value.url != blank or a_images_value.aspect_ratio != blank
      assign has_images = true
    endif
  endif

  assign media_width_desktop = '100vw'
  assign media_width_mobile = '100vw'
  assign sizes = 'auto, (min-width: 750px) ' | append: media_width_desktop | append: ', ' | append: media_width_mobile
  assign widths = '240, 352, 832, 1200, 1600, 1920, 2560, 3840'
%}

{% capture class %}
  a-plus-contents a-plus-contents--{{ block.id }} a-plus-contents--height-{{ block_settings.height }} spacing-style size-style
{% endcapture %}

{% capture style %}
  --a-plus-gap: {{ block_settings.gap | default: 20 }}px;
  {% render 'size-style', settings: block_settings %}
  {% render 'spacing-style', settings: block_settings %}
{% endcapture %}

{% if has_images or request.design_mode %}
  <div
    class="{{ class }}"
    style="{{ style }}"
    {{ block.shopify_attributes }}
  >
    <div class="a-plus-contents__container">
      {% if has_images %}
        {% if a_images_value.first != blank or a_images_value.size > 0 %}
          {% for img in a_images_value %}
            {% liquid
              assign ratio = 1
              case block_settings.image_ratio
                when 'landscape'
                  assign ratio = '16 / 9'
                when 'portrait'
                  assign ratio = '4 / 5'
                when 'adapt'
                  assign ratio = img.aspect_ratio
                when '4/5'
                  assign ratio = '4/5'
                when '5/4'
                  assign ratio = '5/4'
              endcase

              if ratio == 0 or ratio == null
                assign ratio = 1
              endif
            %}
            {% capture image_border_style %}
              --ratio: {{ ratio }};
              {% render 'border-override', settings: block_settings %}
            {% endcapture %}

            <div class="a-plus-contents__item">
              {% if img.width != blank or img.preview_image != blank or img.aspect_ratio != blank %}
                {{
                  img
                  | image_url: width: 3840
                  | image_tag:
                    width: img.width,
                    widths: widths,
                    height: img.height,
                    class: 'a-plus-contents__image border-style',
                    style: image_border_style,
                    sizes: sizes,
                    alt: img.alt
                  | default: target_product.title
                }}
              {% endif %}
            </div>
          {% endfor %}
        {% else %}
          {% liquid
            assign ratio = 1
            case block_settings.image_ratio
              when 'landscape'
                assign ratio = '16 / 9'
              when 'portrait'
                assign ratio = '4 / 5'
              when 'adapt'
                assign ratio = a_images_value.aspect_ratio
              when '4/5'
                assign ratio = '4/5'
              when '5/4'
                assign ratio = '5/4'
            endcase

            if ratio == 0 or ratio == null
              assign ratio = 1
            endif
          %}
          {% capture image_border_style %}
            --ratio: {{ ratio }};
            {% render 'border-override', settings: block_settings %}
          {% endcapture %}

          <div class="a-plus-contents__item">
            {% if a_images_value.width != blank or a_images_value.preview_image != blank %}
              {{
                a_images_value
                | image_url: width: 3840
                | image_tag:
                  width: a_images_value.width,
                  widths: widths,
                  height: a_images_value.height,
                  class: 'a-plus-contents__image border-style',
                  style: image_border_style,
                  sizes: sizes,
                  alt: a_images_value.alt
                | default: target_product.title
              }}
            {% endif %}
          </div>
        {% endif %}
      {% elsif request.design_mode %}
        {% capture image_border_style %}
          --ratio: 1;
          {% render 'border-override', settings: block_settings %}
        {% endcapture %}
        <div class="placeholder-image border-style size-style" style="{{ image_border_style }}">
          {{ 'detailed-apparel-1' | placeholder_svg_tag: 'a-plus-contents__placeholder' }}
        </div>
      {% endif %}
    </div>
  </div>
{% endif %}

{% stylesheet %}
  .a-plus-contents__placeholder {
    height: 100%;
    width: 100%;
    object-fit: cover;
    object-position: center center;
    overflow: hidden;
    position: relative;
  }

  .placeholder-image {
    position: relative;
    aspect-ratio: var(--ratio);
    overflow: hidden;
    width: 100%;
  }

  .a-plus-contents {
    display: flex;
    justify-content: var(--horizontal-alignment, center);
    width: 100%;
  }

  .a-plus-contents__container {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--a-plus-gap, 20px);
    width: 100%;
  }

  .a-plus-contents__item {
    display: flex;
    justify-content: center;
    align-items: center;
    width: 100%;
  }

  .a-plus-contents--height-fill .a-plus-contents__image {
    height: 100%;
  }

  .a-plus-contents__image {
    object-fit: cover;
    aspect-ratio: var(--ratio);
    width: 100%;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "A+ contents",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Product & Metafield"
    },
    {
      "type": "product",
      "id": "product",
      "label": "t:settings.product",
      "info": "Select product to display A+ Images. If blank, current page product is used."
    },
    {
      "type": "text",
      "id": "metafield_key",
      "label": "Metafield key",
      "default": "custom.a_images",
      "info": "Metafield namespace and key for A+ images list (e.g., custom.a_images)."
    },
    {
      "type": "header",
      "content": "Layout & Spacing"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Gap between images",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 20
    },
    {
      "type": "header",
      "content": "t:content.size"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "t:settings.aspect_ratio",
      "options": [
        {
          "value": "adapt",
          "label": "t:options.auto"
        },
        {
          "value": "portrait",
          "label": "t:options.portrait"
        },
        {
          "value": "square",
          "label": "t:options.square"
        },
        {
          "value": "landscape",
          "label": "t:options.landscape"
        },
        {
          "value": "4/5",
          "label": "4/5"
        },
        {
          "value": "5/4",
          "label": "5/4"
        }
      ],
      "default": "adapt"
    },
    {
      "type": "select",
      "id": "width",
      "label": "t:settings.width_desktop",
      "options": [
        {
          "value": "fit-content",
          "label": "t:options.fit_content"
        },
        {
          "value": "fill",
          "label": "t:options.fill"
        },
        {
          "value": "custom",
          "label": "t:options.custom"
        }
      ],
      "default": "fill"
    },
    {
      "type": "range",
      "id": "custom_width",
      "label": "t:settings.custom_width",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ block.settings.width == 'custom' }}"
    },
    {
      "type": "select",
      "id": "width_mobile",
      "label": "t:settings.width_mobile",
      "options": [
        {
          "value": "fit-content",
          "label": "t:options.fit_content"
        },
        {
          "value": "fill",
          "label": "t:options.fill"
        },
        {
          "value": "custom",
          "label": "t:options.custom"
        }
      ],
      "default": "fill"
    },
    {
      "type": "range",
      "id": "custom_width_mobile",
      "label": "t:settings.custom_width",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ block.settings.width_mobile == 'custom' }}"
    },
    {
      "type": "select",
      "id": "height",
      "label": "t:settings.height",
      "options": [
        {
          "value": "fit",
          "label": "t:options.fit_content"
        },
        {
          "value": "fill",
          "label": "t:options.fill"
        }
      ],
      "default": "fit",
      "visible_if": "{{ block.settings.image_ratio == 'adapt' }}"
    },
    {
      "type": "header",
      "content": "t:content.borders"
    },
    {
      "type": "select",
      "id": "border",
      "label": "t:settings.style",
      "options": [
        {
          "value": "none",
          "label": "t:options.none"
        },
        {
          "value": "solid",
          "label": "t:options.solid"
        }
      ],
      "default": "none"
    },
    {
      "type": "range",
      "id": "border_width",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "t:settings.thickness",
      "default": 1,
      "visible_if": "{{ block.settings.border != 'none' }}"
    },
    {
      "type": "range",
      "id": "border_opacity",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "label": "t:settings.opacity",
      "default": 100,
      "visible_if": "{{ block.settings.border != 'none' }}"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "t:settings.color",
      "placeholder": "t:settings.default",
      "visible_if": "{{ block.settings.border != 'none' }}"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "t:settings.border_radius",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "t:settings.left",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "t:settings.right",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "A+ contents"
    }
  ]
}
{% endschema %}
