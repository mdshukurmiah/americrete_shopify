          "blocks": {
            "testimonial_carousel_ctyWmB": {
              "type": "testimonial-carousel",
              "name": "Testimonial Carousel",
              "settings": {
                "full_width": true,
                "columns": 3,
                "mobile_columns": 1,
                "column_gap": 24,
                "show_arrows": false,
                "show_dots": true,
                "color_arrows": "{{ settings.color_palette.foreground }}",
                "color_dots": "{{ settings.color_palette.foreground }}",
                "color_text": "#1c1d1d",
                "color_background": "rgba(0,0,0,0)",
                "gradient_background": "",
                "color_verified": "#225b32",
                "padding-block-start": 0,
                "padding-block-end": 0
              },
              "blocks": {
                "testimonial_AcrCEL": {
                  "type": "_testimonial",
                  "settings": {
                    "icon": "5-stars",
                    "start_count_text": "5.0",
                    "testimonial_title": "",
                    "testimonial": "<p>\"I tried everything for my high blood pressure: hawthorn, garlic, beet root. Wasted two years and nothing worked. Started Hale Heart at 10,800 FU and within 10 weeks my BP went from 152/92 to 121/78. This is the real deal.\"</p>",
                    "round_images": true,
                    "author": "David T.",
                    "author_info": "",
                    "verified": true
                  },
                  "blocks": {}
                },
                "testimonial_BggbHa": {
                  "type": "_testimonial",
                  "settings": {
                    "icon": "5-stars",
                    "start_count_text": "5.0",
                    "testimonial_title": "",
                    "testimonial": "<p>\"I was skeptical before trying this, but after 3 weeks I started feeling better than ever. My doctor even asked what changed''</p>",
                    "round_images": true,
                    "author": "Linda R.",
                    "author_info": "",
                    "verified": true
                  },
                  "blocks": {}
                },
                "testimonial_WBPFat": {
                  "type": "_testimonial",
                  "settings": {
                    "icon": "5-stars",
                    "start_count_text": "4.9",
                    "testimonial_title": "",
                    "testimonial": "<p>\"My hands used to be cold all the time, even in the summer with the AC. That's the first thing I noticed go away. My husband takes it too. He says his legs aren't as tired after he does the yard.\"</p>",
                    "round_images": true,
                    "author": "Sarah B.",
                    "author_info": "",
                    "verified": true
                  },
                  "blocks": {}
                },
                "testimonial_wjVr7N": {
                  "type": "_testimonial",
                  "settings": {
                    "icon": "5-stars",
                    "start_count_text": "5.0",
                    "testimonial_title": "",
                    "testimonial": "<p>\"I had a whole shelf of bottles. CoQ10, turmeric, vitamin k2, a nattokinase one. This replaced four of them. My counter looks better and I'm spending less. That alone was worth it. The way I feel is a bonus.\"</p>",
                    "round_images": true,
                    "author": "Daniel W.",
                    "author_info": "",
                    "verified": true
                  },
                  "blocks": {}
                },
                "testimonial_BpTXPj": {
                  "type": "_testimonial",
                  "settings": {
                    "icon": "5-stars",
                    "start_count_text": "5.0",
                    "testimonial_title": "",
                    "testimonial": "<p>\"My sister forwarded me the article. I rolled my eyes because she's always sending me stuff. But I read it. Then I sat on it for a week. Then I ordered it last summer. My bloodwork in june was the best it's been in years. Don't tell my sister she was right.\"</p>",
                    "round_images": true,
                    "author": "Jessica T.",
                    "author_info": "",
                    "verified": true
                  },
                  "blocks": {}
                },
                "testimonial_6t76Mx": {
                  "type": "_testimonial",
                  "settings": {
                    "icon": "5-stars",
                    "start_count_text": "4.9",
                    "testimonial_title": "",
                    "testimonial": "<p>\"I'm 71. Been on a cholesterol pill since I was 58. Showed the bottle to my internist before I started, she said it was fine, just to keep an eye on my INR which I do anyway. BP's down, mind feels clearer in the mornings and more energy throughout the day. Could be coincidence but I don't think so\"</p>",
                    "round_images": true,
                    "author": "William S.",
                    "author_info": "",
                    "verified": true
                  },
                  "blocks": {}
                },
                "testimonial_aa33YM": {
                  "type": "_testimonial",
                  "settings": {
                    "icon": "5-stars",
                    "start_count_text": "4.9",
                    "testimonial_title": "",
                    "testimonial": "<p>''This actually works. I just turned 54 years old. I've tried all supplements for plaque and heart health but nothing compares to this. My blood flow feels stronger, I have more stamina, and my energy is steady all day. No more afternoon crashes''</p>",
                    "round_images": true,
                    "author": "Thomas P.",
                    "author_info": "",
                    "verified": true
                  },
                  "blocks": {}
                }
              },
