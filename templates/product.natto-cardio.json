                          "type": "text",
                          "settings": {
                            "text": "<p>Most orders arrive within 3–4 business days, and you'll receive a tracking number the moment your order has been shipped out from our warehouse.</p>",
                            "width": "100%",
                            "max_width": "normal",
                            "alignment": "left",
