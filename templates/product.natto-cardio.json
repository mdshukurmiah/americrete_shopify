                            "padding-block-start": 0,
                            "padding-block-end": 0,
                            "padding-inline-start": 0,
                            "padding-inline-end": 0
                          },
                          "blocks": {}
                        }
                      },
                      "block_order": [
                        "text_Ck8PUJ"
                      ]
                    },
                    "accordion_row_fQrRqF": {
                      "type": "_accordion-row",
                      "settings": {
                        "heading": "How To Take?",
                        "open_by_default": false,
                        "icon": "none",
                        "width": 20
                      },
                      "blocks": {
                        "text_JppD9q": {
                          "type": "text",
                          "settings": {
                            "text": "<ul><li>Take 2 Softgels Daily</li><li>Take With Food And Water For Best Absorption</li></ul><p>Each bottle contains 60 Softgels — a full 30-day supply.</p>",
                            "width": "100%",
                            "max_width": "normal",
