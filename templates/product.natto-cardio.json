                      "blocks": {
                        "text_cb7JpE": {
                          "type": "text",
                          "settings": {
                            "text": "<p>We stand behind ourvascular formula with a 60-day money-back guarantee.<br/><br/>If you’re not satisfied for any reason, simply contact our support team and we’ll issue a full refund — no questions asked.<br/><br/>Support email:<strong>support@trypridewell.com</strong></p>",
                            "width": "100%",
                            "max_width": "normal",
                            "alignment": "left",
                            "type_preset": "custom",
                            "font": "var(--font-body--family)",
                            "font_size": "0.875rem",
                            "font_size_mobile": "",
                            "weight": "",
                            "line_height": "normal",
                            "letter_spacing": "normal",
                            "case": "none",
                            "wrap": "pretty",
                            "text_color": "",
                            "highlight_color": "",
                            "background": false,
                            "background_color": "#00000026",
                            "corner_radius": 0,
                            "padding-block-start": 0,
